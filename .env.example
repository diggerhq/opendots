# Copy to .env.local for a local run (npm run setup fills it in); on a host, set these as secrets.
# The five uncommented names are required and are what a deploy button prompts for
# (the Deploy to Cloudflare button reads this file). Everything commented out has a default.
OPENCOMPUTER_API_KEY=            # the OpenComputer key; server only, never sent to the browser
OPENCOMPUTER_PROJECT_ID=         # the linked OpenComputer project (npm run setup writes it)
OPENDOT_OWNER_SECRET=           # what the owner types into the login form (npm run setup generates it; 16+ chars)
OPENDOT_COOKIE_SECRET=          # signs the owner cookie (npm run setup generates it; 32+ chars)
OPENDOT_AGENT_SECRET=           # the installation secret the agents present to /api/agent/*; the app registers it with the platform at sign-in (32+ chars)
# Optional, with defaults
# OPENCOMPUTER_ENVIRONMENT=      # development (default) or production; memory documents and sessions live in one of them
# OPENCOMPUTER_API_URL=          # default https://app.opencomputer.dev
# OPENDOT_APP_ORIGIN=           # the app's public https origin; default: the origin of each request
# OPENDOT_INSTALLATION_ID=      # part of every session idempotency key (one installation per project and environment); default "default"
# OPENDOT_COORDINATOR_AGENT=    # default opendot-dev
# OPENDOT_WORKER_AGENT=         # default opendot-dev--topic-worker
# OPENDOT_STATE_STORE=          # the session map: fs (default), kv (Cloudflare), memory (lost on restart)
# OPENDOT_STATE_DIR=            # for fs: default ./.opendot (the Docker image sets /data)
# OPENDOT_ALLOW_INSECURE_COOKIES= # 1 drops the Secure cookie attribute for plain-http localhost
# PORT=                          # for npm start; default 3000
