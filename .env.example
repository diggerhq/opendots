# Copy to .env.local for a local run (npm run setup fills it in); on a host, set these as secrets.
# The five uncommented names are required and are what a deploy button prompts for
# (the Deploy to Cloudflare button reads this file). Everything commented out has a default.
OPENCOMPUTER_API_KEY=            # the OpenComputer key; server only, never sent to the browser
OPENCOMPUTER_PROJECT_ID=         # the linked OpenComputer project (npm run setup writes it)
OPENDOTS_OWNER_SECRET=           # what the owner types into the login form (npm run setup generates it; 16+ chars)
OPENDOTS_COOKIE_SECRET=          # signs the owner cookie (npm run setup generates it; 32+ chars)
OPENDOTS_AGENT_SECRET=           # the installation secret the agents present to /api/agent/*; the app registers it with the platform at sign-in (32+ chars)
# Optional, with defaults
# OPENCOMPUTER_ENVIRONMENT=      # development (default) or production; memory documents and sessions live in one of them
# OPENCOMPUTER_API_URL=          # default https://app.opencomputer.dev
# OPENDOTS_APP_ORIGIN=           # the app's public https origin; default: the origin of each request
# OPENDOTS_INSTALLATION_ID=      # part of every session idempotency key (one installation per project and environment); default "default"
# OPENDOTS_COORDINATOR_AGENT=    # default opendots-dev
# OPENDOTS_WORKER_AGENT=         # default opendots-dev--topic-worker
# OPENDOTS_STATE_STORE=          # the session map: fs (default), kv (Cloudflare), memory (lost on restart)
# OPENDOTS_STATE_DIR=            # for fs: default ./.opendots (the Docker image sets /data)
# OPENDOTS_ALLOW_INSECURE_COOKIES= # 1 drops the Secure cookie attribute for plain-http localhost
# PORT=                          # for npm start; default 3000
